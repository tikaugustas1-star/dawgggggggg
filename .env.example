# Copy to .env (loaded automatically by server/index.js). All values are LOCAL DEMO values.
PORT=3001
PUBLIC_URL=http://localhost:3001
STORE_TZ=Europe/Vilnius
# BRAND_CONFIG=./brands/my-brand.json

# Seeded demo accounts (change before any real deployment)
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=Demo-Admin-2026!
STAFF_EMAIL=virtuve@demo.local
STAFF_PASSWORD=Demo-Virtuve-2026!
CUSTOMER_EMAIL=klientas@demo.local
CUSTOMER_PASSWORD=Demo-Klientas-2026!

# Payments: set Stripe TEST keys to enable real card checkout (sk_test_..., whsec_...).
# Without them the card option runs as a clearly labelled DEMO (no money moves). PAYMENTS_DEMO=0 disables it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_DEMO=1
